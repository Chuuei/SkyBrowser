<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CosineKitty.AstronomyEngine" Version="2.1.19" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="15.0.0" GeneratePathProperty="true" />
    <ProjectReference Include="$(XisfLibraryRoot)\XISFLib\XISFLib.csproj" />
    <EmbeddedResource Include="Data\*.json" />
    <None Include="Data\LICENSE-*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Data\deep-sky.json" CopyToOutputDirectory="PreserveNewest" />
    <None
      Include="$(PkgMagick_NET-Q16-AnyCPU)\Notice.txt"
      Link="Data\Magick.NET-Notice.txt"
      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
