<Window x:Class="SkyBrowser.Desktop.SkyToolsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:services="clr-namespace:SkyBrowser.Desktop.Services"
  xmlns:controls="clr-namespace:SkyBrowser.Desktop.Controls"
  Title="SkyBrowser · Sky tools" Width="960" Height="850" MinWidth="800" MinHeight="660"
  Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TabControl x:Name="ToolsTabs">
      <TabItem Header="Survey background">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14">
            <TextBlock Text="Survey imagery behind your photographs" FontSize="20" Margin="0,0,0,10" />
            <TextBlock Text="Load a DSS survey cutout for the current atlas view. Downloads occur only when requested and send its sky coordinates to CDS. Saved regions work offline." TextWrapping="Wrap" Foreground="{DynamicResource UiBrush8D9AAD}" Margin="0,0,0,14" />
            <ComboBox x:Name="SurveyChoice" AutomationProperties.Name="Survey dataset" />
            <WrapPanel Margin="0,14,0,12" x:Name="SurveyLoadControls">
              <CheckBox x:Name="SurveyOffline" Content="Offline only" VerticalAlignment="Center" />
              <Button x:Name="LoadSurveyButton" Content="Load current view" Click="LoadSurveyClicked" />
              <Button x:Name="RemoveSurveyButton" Content="Remove backgrounds" Click="RemoveSurveyClicked" Margin="8,0,0,0" />
            </WrapPanel>
            <Button x:Name="CancelSurveyButton" Content="Cancel survey load" Click="CancelSurveyClicked" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,0,0,12" />
            <TextBlock Text="Background opacity" Foreground="{DynamicResource UiBrush8D9AAD}" />
            <Slider x:Name="SurveyOpacityChoice" Minimum="0" Maximum="1" Value="0.75" ValueChanged="SurveyOpacityChanged" Margin="0,7,0,15" AutomationProperties.Name="Survey background opacity" />
            <CheckBox x:Name="CatalogOverlayChoice" Content="Show catalogue positions (OpenNGC / Messier / Caldwell)" Click="OverlayChoicesChanged" Margin="0,0,0,16" />
            <TextBlock Text="Saved survey regions" FontWeight="SemiBold" Margin="0,0,0,7" />
            <ListBox x:Name="CachedSurveyList" Height="230" AutomationProperties.Name="Cached survey regions" />
            <WrapPanel Margin="0,10,0,8" x:Name="SurveyCacheControls">
              <Button Content="Show selected saved region" Click="ShowCachedSurveyClicked" />
              <Button Content="Clear survey cache" Click="ClearSurveyCacheClicked" Margin="8,0,0,0" />
            </WrapPanel>
            <TextBlock x:Name="SurveyCacheSummary" services:Accessibility.LiveSetting="Polite" Foreground="{DynamicResource UiBrush8D9AAD}" Margin="0,0,0,14" />
            <TextBlock x:Name="SurveyAttribution" TextWrapping="Wrap" Foreground="{DynamicResource UiBrushA2B6CA}" />
            <TextBlock Text="Data credits and survey terms: Data/LICENSE-DSS-SURVEYS.txt. Survey attribution stays visible in the atlas and exported sky images." TextWrapping="Wrap" Foreground="{DynamicResource UiBrush8D9AAD}" Margin="0,8,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="VisibilityTab" Header="Target visibility">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14" TextBox.TextChanged="VisibilityInputChanged">
            <TextBlock Text="Plan a 24-hour observing period" FontSize="20" Margin="0,0,0,12" />
            <WrapPanel>
              <StackPanel Width="135"><TextBlock Text="Target RA (J2000 degrees)" FontSize="10" /><TextBox x:Name="PlanRa" AutomationProperties.Name="Planning target right ascension (degrees)" Margin="0,5,0,0" /></StackPanel>
              <StackPanel Width="135" Margin="10,0,0,0"><TextBlock Text="Declination (degrees)" FontSize="10" /><TextBox x:Name="PlanDec" AutomationProperties.Name="Planning target declination (degrees)" Margin="0,5,0,0" /></StackPanel>
              <Button Content="Use atlas center" Click="UsePlanningCenterClicked" Margin="12,16,0,0" />
            </WrapPanel>
            <WrapPanel Margin="0,12,0,0">
              <StackPanel Width="135"><TextBlock Text="Latitude (north +)" FontSize="10" /><TextBox x:Name="PlanLatitude" AutomationProperties.Name="Planning latitude (degrees north)" Margin="0,5,0,0" /></StackPanel>
              <StackPanel Width="135" Margin="10,0,0,0"><TextBlock Text="Longitude (east +)" FontSize="10" /><TextBox x:Name="PlanLongitude" AutomationProperties.Name="Planning longitude (degrees east)" Margin="0,5,0,0" /></StackPanel>
              <Button Content="Use observer location" Click="UseObserverClicked" Margin="12,16,0,0" />
            </WrapPanel>
            <WrapPanel Margin="0,12,0,0">
              <StackPanel Width="150"><TextBlock Text="Start date (UTC)" FontSize="10" /><DatePicker x:Name="PlanDate" AutomationProperties.Name="Planning start date (UTC)" Margin="0,5,0,0" SelectedDateChanged="VisibilityDateChanged" /></StackPanel>
              <StackPanel Width="110" Margin="10,0,0,0"><TextBlock Text="Start time (HH:mm UTC)" FontSize="10" /><TextBox x:Name="PlanTime" AutomationProperties.Name="Planning start time (UTC HH:mm)" Text="12:00" Margin="0,5,0,0" /></StackPanel>
              <StackPanel Width="120" Margin="10,0,0,0"><TextBlock Text="Target at least (°)" FontSize="10" /><TextBox x:Name="PlanMinAltitude" AutomationProperties.Name="Minimum target altitude (degrees)" Text="30" Margin="0,5,0,0" /></StackPanel>
              <StackPanel Width="120" Margin="10,0,0,0"><TextBlock Text="Sun at most (°)" FontSize="10" /><TextBox x:Name="PlanMaxSun" AutomationProperties.Name="Maximum Sun altitude (degrees)" Text="-18" Margin="0,5,0,0" /></StackPanel>
              <StackPanel Width="135" Margin="10,0,0,0"><TextBlock Text="Moon separation at least (°)" FontSize="10" /><TextBox x:Name="PlanMinMoon" AutomationProperties.Name="Minimum Moon separation (degrees)" Text="30" Margin="0,5,0,0" /></StackPanel>
            </WrapPanel>
            <WrapPanel Margin="0,12,0,8">
              <CheckBox x:Name="PlanIgnoreLowMoon" Content="Ignore separation while Moon is below horizon" IsChecked="True" VerticalAlignment="Center" Click="VisibilityCriteriaChanged" />
              <Button x:Name="CalculateVisibilityButton" Content="Calculate visibility" Click="CalculateVisibilityClicked" />
              <Button x:Name="CancelPlanningButton" Content="Cancel" Click="CancelPlanningClicked" Margin="8,0,0,0" Visibility="Collapsed" />
            </WrapPanel>
            <TextBlock Text="Mint: target · Gold: Sun · Blue: Moon · Green shading: imaging windows · Time axis: UTC" Foreground="{DynamicResource UiBrush8D9AAD}" FontSize="11" />
            <controls:VisibilityChart x:Name="AltitudeChart" Height="280" Margin="0,10,0,10" />
            <TextBlock x:Name="VisibilitySummary" services:Accessibility.LiveSetting="Polite" TextWrapping="Wrap" LineHeight="19" />
            <TextBlock Text="Geometric altitudes use a flat horizon, without atmospheric refraction, terrain or weather. Curves and short-window detection use two-minute samples; detected boundaries are refined. Results use the temporary location above and do not change startup options." TextWrapping="Wrap" Foreground="{DynamicResource UiBrush8D9AAD}" FontSize="11" Margin="0,14,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Measurements">
        <ScrollViewer x:Name="MeasurementsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="14">
            <TextBlock Text="Measure on the sky" FontSize="20" Margin="0,0,0,16" />
            <WrapPanel>
              <CheckBox x:Name="ScaleBarChoice" Content="Angular scale bar" Click="OverlayChoicesChanged" />
              <CheckBox x:Name="NorthEastChoice" Content="Celestial north / east" Click="OverlayChoicesChanged" ToolTip="J2000 sky directions, separate from the observer's horizon compass" />
            </WrapPanel>
            <WrapPanel Margin="0,14,0,8">
              <Button Content="Measure two points on sky" Click="BeginMeasurementClicked" />
              <Button Content="Use atlas center as next point" Click="MeasureCenterClicked" Margin="8,0,0,0" />
              <Button Content="Clear measurement" Click="ClearMeasurementClicked" Margin="8,0,0,0" />
            </WrapPanel>
            <WrapPanel Margin="0,0,0,10">
              <TextBlock Text="A RA / Dec (°)" VerticalAlignment="Center" />
              <TextBox x:Name="MeasureRaA" Text="0" Width="85" Margin="8,0,4,0" AutomationProperties.Name="Measurement A right ascension (degrees)" />
              <TextBox x:Name="MeasureDecA" Text="0" Width="85" Margin="0,0,12,0" AutomationProperties.Name="Measurement A declination (degrees)" />
              <TextBlock Text="B RA / Dec (°)" VerticalAlignment="Center" />
              <TextBox x:Name="MeasureRaB" Text="90" Width="85" Margin="8,0,4,0" AutomationProperties.Name="Measurement B right ascension (degrees)" />
              <TextBox x:Name="MeasureDecB" Text="0" Width="85" Margin="0,0,8,0" AutomationProperties.Name="Measurement B declination (degrees)" />
              <Button Content="Measure coordinates" Click="MeasureExactClicked" />
            </WrapPanel>
            <TextBlock x:Name="MeasurementSummary" services:Accessibility.LiveSetting="Polite" Text="Distances follow the shortest great-circle arc. Enter coordinates above, choose catalogue targets below, or pick two points in the atlas." TextWrapping="Wrap" Foreground="{DynamicResource UiBrush8D9AAD}" />
            <WrapPanel x:Name="MeasurementDistanceInputs" Margin="0,12,0,6" IsEnabled="False">
              <TextBlock Text="Distance from us (light-years):" VerticalAlignment="Center" Margin="0,0,12,0" />
              <TextBlock Text="A" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBox x:Name="MeasurementDistanceA" Width="125" TextChanged="MeasurementDistancesChanged" AutomationProperties.Name="Distance to object A in light-years" ToolTip="Optional distance from us to the first measured object, in light-years" />
              <TextBlock Text="B" VerticalAlignment="Center" Margin="16,0,6,0" />
              <TextBox x:Name="MeasurementDistanceB" Width="125" TextChanged="MeasurementDistancesChanged" AutomationProperties.Name="Distance to object B in light-years" ToolTip="Optional distance from us to the second measured object, in light-years" />
            </WrapPanel>
            <TextBlock x:Name="PhysicalDistanceSummary" services:Accessibility.LiveSetting="Polite" Text="Supply both known object distances, or choose catalogue targets below for an offline published estimate." TextWrapping="Wrap" Foreground="{DynamicResource UiBrush8D9AAD}" />
            <Border BorderBrush="{DynamicResource UiBrush293548}" BorderThickness="0,1,0,0" Margin="0,24,0,0" />
            <StackPanel x:Name="KnownTargetsPanel" Margin="0,18,0,0">
              <StackPanel Margin="0,0,0,14">
                <TextBlock x:Name="KnownTargetsHeading" Text="Choose catalogue targets" FontSize="20" Margin="0,0,0,8" />
                <TextBlock x:Name="DistanceCoverage" TextWrapping="Wrap" Foreground="{DynamicResource UiBrush8D9AAD}" />
              </StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="Target A" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="Target B" FontWeight="SemiBold" />
                <TextBox x:Name="DistanceSearchA" Grid.Row="1" Margin="0,7,0,8" TextChanged="DistanceSearchChanged" AutomationProperties.Name="Search distance target A" ToolTip="Search a designation or common name, for example M 81, NGC 3031 or Bode" />
                <TextBox x:Name="DistanceSearchB" Grid.Row="1" Grid.Column="2" Margin="0,7,0,8" TextChanged="DistanceSearchChanged" AutomationProperties.Name="Search distance target B" ToolTip="Search a designation or common name, for example M82 or Cigar" />
                <ListBox x:Name="DistanceTargetsA" Grid.Row="2" MinHeight="44" MaxHeight="140" SelectionChanged="DistanceTargetChanged" AutomationProperties.Name="Distance target A" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
                <ListBox x:Name="DistanceTargetsB" Grid.Row="2" Grid.Column="2" MinHeight="44" MaxHeight="140" SelectionChanged="DistanceTargetChanged" AutomationProperties.Name="Distance target B" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
                <TextBlock x:Name="DistanceSourceA" Grid.Row="3" Margin="0,10,0,6" TextWrapping="Wrap" Foreground="{DynamicResource UiBrushA2B6CA}" />
                <TextBlock x:Name="DistanceSourceB" Grid.Row="3" Grid.Column="2" Margin="0,10,0,6" TextWrapping="Wrap" Foreground="{DynamicResource UiBrushA2B6CA}" />
                <Button x:Name="DistanceSourceButtonA" Grid.Row="4" Content="Open source for A" Click="OpenDistanceSourceClicked" HorizontalAlignment="Left" IsEnabled="False" />
                <Button x:Name="DistanceSourceButtonB" Grid.Row="4" Grid.Column="2" Content="Open source for B" Click="OpenDistanceSourceClicked" HorizontalAlignment="Left" IsEnabled="False" />
              </Grid>
              <StackPanel Margin="0,12,0,0">
                <TextBlock x:Name="TargetDistanceResult" services:Accessibility.LiveSetting="Polite" Text="Select target A and target B to measure their separation." FontSize="17" Foreground="{DynamicResource UiBrush8BE2C3}" TextWrapping="Wrap" />
                <TextBlock x:Name="TargetDistanceAngle" TextWrapping="Wrap" Foreground="{DynamicResource UiBrushA2B6CA}" Margin="0,7,0,0" />
                <TextBlock Text="Published estimates; close-pair separations can be uncertain. Reported object errors appear in source details; separation uncertainty and cosmology are not modelled. For other objects, use the sky-point controls and manual distances above."
                  TextWrapping="Wrap" Foreground="{DynamicResource UiBrush8D9AAD}" Margin="0,6,0,8" />
                <WrapPanel>
                  <Button x:Name="DistanceFrameButton" Content="Frame selected pair" Click="FrameDistancePairClicked" />
                  <Button x:Name="DistanceMarkedButton" Content="Use two marked targets" Click="UseMarkedDistanceTargetsClicked" Margin="8,0,0,0" />
                  <Button x:Name="DistanceClearButton" Content="Clear target pair" Click="ClearDistancePairClicked" Margin="8,0,0,0" />
                  <Button x:Name="DistanceSpaceButton" Content="Explore objects in 3D…" Click="OpenDistanceSpaceClicked" Margin="8,0,0,0" />
                </WrapPanel>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="FramingTab" Header="Framing &amp; mosaics">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="14">
            <TextBlock Text="Plan your next photograph" FontSize="20" Margin="0,0,0,10" />
            <TextBlock Text="Choose a telescope or your own camera field, then show its footprint on the atlas. Use Find in sky first to choose a target, and take the atlas center below." TextWrapping="Wrap" Foreground="{DynamicResource UiBrush8D9AAD}" Margin="0,0,0,12" />
            <ComboBox x:Name="EquipmentChoice" IsTextSearchEnabled="True" TextSearch.TextPath="Name" MaxDropDownHeight="320" SelectionChanged="EquipmentChanged" AutomationProperties.Name="Equipment profile" />
            <TextBlock x:Name="EquipmentSource" Foreground="{DynamicResource UiBrushA2B6CA}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,8" />
            <WrapPanel>
              <StackPanel Width="270"><TextBlock Text="Custom profile name" FontSize="11" /><TextBox x:Name="EquipmentName" AutomationProperties.Name="Equipment profile name" Margin="0,5,0,0" TextChanged="FramingInputChanged" /></StackPanel>
              <StackPanel Width="120" Margin="10,0,0,0"><TextBlock Text="Field width (°)" FontSize="11" /><TextBox x:Name="FieldWidth" AutomationProperties.Name="Camera field width (degrees)" Text="0.73" Margin="0,5,0,0" TextChanged="FramingInputChanged" /></StackPanel>
              <StackPanel Width="120" Margin="10,0,0,0"><TextBlock Text="Field height (°)" FontSize="11" /><TextBox x:Name="FieldHeight" AutomationProperties.Name="Camera field height (degrees)" Text="1.29" Margin="0,5,0,0" TextChanged="FramingInputChanged" /></StackPanel>
              <Button x:Name="SaveEquipmentButton" Content="Save custom profile" Click="SaveEquipmentClicked" Margin="10,18,0,0" />
              <Button x:Name="DeleteEquipmentButton" Content="Remove custom" Click="DeleteEquipmentClicked" Margin="8,18,0,0" IsEnabled="False" />
            </WrapPanel>
            <Expander Header="Calculate a field from sensor and focal length" Margin="0,10,0,0">
              <WrapPanel Margin="0,8,0,0">
                <StackPanel Width="130"><TextBlock Text="Sensor width (mm)" FontSize="11" /><TextBox x:Name="SensorWidth" AutomationProperties.Name="Sensor width (millimeters)" Text="23.5" Margin="0,5,0,0" /></StackPanel>
                <StackPanel Width="130" Margin="10,0,0,0"><TextBlock Text="Sensor height (mm)" FontSize="11" /><TextBox x:Name="SensorHeight" AutomationProperties.Name="Sensor height (millimeters)" Text="15.7" Margin="0,5,0,0" /></StackPanel>
                <StackPanel Width="155" Margin="10,0,0,0"><TextBlock Text="Effective focal length (mm)" FontSize="11" /><TextBox x:Name="FramingFocalLength" AutomationProperties.Name="Focal length (millimeters)" Text="500" Margin="0,5,0,0" /></StackPanel>
                <Button Content="Use calculated field" Click="CalculateFieldClicked" Margin="10,18,0,0" />
              </WrapPanel>
            </Expander>
            <WrapPanel Margin="0,14,0,0">
              <StackPanel Width="145"><TextBlock Text="Center RA (J2000 °)" FontSize="11" /><TextBox x:Name="FramingRa" AutomationProperties.Name="Frame center right ascension (degrees)" TextChanged="FramingInputChanged" Margin="0,5,0,0" /></StackPanel>
              <StackPanel Width="145" Margin="10,0,0,0"><TextBlock Text="Declination (°)" FontSize="11" /><TextBox x:Name="FramingDec" AutomationProperties.Name="Frame center declination (degrees)" TextChanged="FramingInputChanged" Margin="0,5,0,0" /></StackPanel>
              <Button Content="Use atlas center" Click="UseFramingCenterClicked" Margin="10,18,0,0" />
              <StackPanel Width="140" Margin="18,0,0,0"><TextBlock Text="Rotation (° CCW)" FontSize="11" /><TextBox x:Name="FramingRotation" AutomationProperties.Name="Camera rotation (degrees)" Text="0" TextChanged="FramingInputChanged" Margin="0,5,0,0" /></StackPanel>
              <Button Content="Rotate 90°" Click="RotateFramingClicked" Margin="10,18,0,0" />
            </WrapPanel>
            <WrapPanel Margin="0,12,0,0">
              <StackPanel Width="100"><TextBlock Text="Rows (1–10)" FontSize="11" /><TextBox x:Name="MosaicRows" AutomationProperties.Name="Mosaic rows" Text="1" TextChanged="FramingInputChanged" Margin="0,5,0,0" /></StackPanel>
              <StackPanel Width="100" Margin="10,0,0,0"><TextBlock Text="Columns (1–10)" FontSize="11" /><TextBox x:Name="MosaicColumns" AutomationProperties.Name="Mosaic columns" Text="1" TextChanged="FramingInputChanged" Margin="0,5,0,0" /></StackPanel>
              <StackPanel Width="140" Margin="10,0,0,0"><TextBlock Text="Overlap (0–80%)" FontSize="11" /><TextBox x:Name="MosaicOverlap" AutomationProperties.Name="Mosaic overlap (%)" Text="20" TextChanged="FramingInputChanged" Margin="0,5,0,0" /></StackPanel>
              <Button x:Name="ShowFramingButton" Content="Show plan on atlas" Click="ShowFramingClicked" Margin="14,18,0,0" />
              <Button Content="Hide plan" Click="HideFramingClicked" Margin="8,18,0,0" />
            </WrapPanel>
            <TextBlock x:Name="FramingSummary" services:Accessibility.LiveSetting="Polite" Text="A single panel frames one exposure; increase rows or columns for a mosaic." Foreground="{DynamicResource UiBrush8BE2C3}" TextWrapping="Wrap" Margin="0,12,0,8" />
            <ListBox x:Name="MosaicPanels" Height="150" SelectionChanged="MosaicPanelChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Planned mosaic panels with J2000 coordinates" />
            <WrapPanel x:Name="FramingActions" IsEnabled="False" Margin="0,10,0,0">
              <Button Content="Fit whole plan" Click="FitFramingClicked" />
              <Button Content="Center selected panel" Click="CenterPanelClicked" Margin="8,0,0,0" />
              <Button x:Name="PanelVisibilityButton" Content="Check panel visibility" Click="PanelVisibilityClicked" Margin="8,0,0,0" />
              <Button Content="Export coordinates…" Click="ExportFramingClicked" Margin="8,0,0,0" />
            </WrapPanel>
            <TextBlock Text="At 0° the field is north up, east left; positive rotation is counterclockwise. Overlap is spacing in the central tangent plane; sky overlap varies over wide mosaics. Panel rotations follow the sphere. Profiles describe native fields, without a telescope's mosaic expansion or lens distortion. Check actual framing in the telescope app; SkyBrowser provides planning and coordinates." Foreground="{DynamicResource UiBrush8D9AAD}" TextWrapping="Wrap" FontSize="11" Margin="0,14,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <TextBlock x:Name="SkyToolsStatus" services:Accessibility.LiveSetting="Polite" Grid.Row="1" Text="Ready" Foreground="{DynamicResource UiBrush8BE2C3}" TextWrapping="Wrap" Margin="0,12,0,0" />
  </Grid>
</Window>
