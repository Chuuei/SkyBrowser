<UserControl
  x:Class="SkyBrowser.Desktop.Controls.SceneTimeline"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Visibility="Collapsed">
  <Border Background="{DynamicResource UiBrush101722}" BorderBrush="{DynamicResource UiBrush253044}" BorderThickness="0,1,0,0" Padding="16,9">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="SCENE TIME" Foreground="{DynamicResource UiBrush8D9AAD}" FontSize="10" VerticalAlignment="Center" />
        <TextBlock x:Name="TimeReadout" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" />
        <TextBlock x:Name="TimeMode" Foreground="{DynamicResource UiBrush8BE2C3}" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
      <Button
        x:Name="LiveButton"
        Grid.Column="2"
        Content="Live now"
        Click="LiveClicked"
        Padding="10,4"
        ToolTip="Return to the current system time and let the clock run" />
      <Button
        x:Name="PreviousDayButton"
        Grid.Row="1"
        Content="−1 day"
        Click="PreviousDayClicked"
        Padding="10,3"
        Margin="0,8,0,0"
        ToolTip="Go back 24 hours and recenter the slider" />
      <Grid Grid.Row="1" Grid.Column="1" Margin="12,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="RangeStart" Foreground="{DynamicResource UiBrush8D9AAD}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Slider
          x:Name="TimeSlider"
          Grid.Column="1"
          Minimum="-720"
          Maximum="720"
          Value="0"
          SmallChange="1"
          LargeChange="60"
          TickFrequency="60"
          IsMoveToPointEnabled="True"
          VerticalAlignment="Center"
          Foreground="{DynamicResource UiBrush8BE2C3}"
          ValueChanged="TimeChanged"
          AutomationProperties.Name="Scene time offset in minutes"
          ToolTip="Drag backward or forward in time. Arrow keys: 1 minute; Page Up/Down: 1 hour. Times use your computer's time zone." />
        <TextBlock x:Name="RangeEnd" Grid.Column="2" Foreground="{DynamicResource UiBrush8D9AAD}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" />
      </Grid>
      <Button
        x:Name="NextDayButton"
        Grid.Row="1"
        Grid.Column="2"
        Content="+1 day"
        Click="NextDayClicked"
        Padding="10,3"
        Margin="0,8,0,0"
        ToolTip="Go forward 24 hours and recenter the slider" />
    </Grid>
  </Border>
</UserControl>
