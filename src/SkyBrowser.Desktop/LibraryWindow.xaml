<Window x:Class="SkyBrowser.Desktop.LibraryWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:services="clr-namespace:SkyBrowser.Desktop.Services"
  Title="SkyBrowser · Image library" Width="980" Height="640" MinWidth="720" MinHeight="480"
  Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="Your image folders" FontSize="25" FontWeight="SemiBold" />
      <TextBlock Text="Manage the folders in your library. Load folders saves this list and loads their images, including subfolders."
        Foreground="{DynamicResource UiBrush8D9AAD}" TextWrapping="Wrap" Margin="0,6,0,0" />
    </StackPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,12" LastChildFill="True">
      <WrapPanel DockPanel.Dock="Right" Margin="12,0,0,0">
        <Button x:Name="AddArchiveButton" Content="Add folder…" Click="AddFolderClicked" Margin="0,0,8,0" />
        <Button x:Name="RemoveArchiveButton" Content="Remove selected" Click="RemoveFolderClicked" IsEnabled="False" Margin="0,0,8,0" />
        <Button x:Name="ClearFoldersButton" Content="Remove all" Click="ClearFoldersClicked" IsEnabled="False" />
      </WrapPanel>
      <Grid MinWidth="120">
        <TextBox x:Name="LibrarySearch" TextChanged="SearchChanged" Padding="10,8"
          ToolTip="Filter folder names and paths. All listed folders load when confirmed, including those hidden by the filter."
          AutomationProperties.Name="Search library folders" />
        <TextBlock x:Name="LibrarySearchPlaceholder" Text="Find a folder" Foreground="{DynamicResource UiBrush73879C}"
          Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False" />
      </Grid>
    </DockPanel>
    <Grid Grid.Row="2">
      <ListBox x:Name="FolderList" AutomationProperties.Name="Library folders" SelectionMode="Extended" SelectionChanged="SelectionChanged"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
        VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ToolTip="{Binding Path}" Margin="0,4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Path}" Foreground="{DynamicResource UiBrush8D9AAD}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource UiBrush8BE2C3}" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="EmptyLibrary" Text="Add a folder to start your library. Images load after you choose Load folders."
        Foreground="{DynamicResource UiBrush8D9AAD}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
        Margin="24" IsHitTestVisible="False" />
    </Grid>
    <StackPanel Grid.Row="3" Margin="0,12,0,16">
      <TextBlock x:Name="LibraryStatus" services:Accessibility.LiveSetting="Polite" Foreground="{DynamicResource UiBrush8BE2C3}" TextWrapping="Wrap" />
      <TextBlock Text="Removing a folder also removes its images from the sky when confirmed. Original files and saved solutions are kept."
        Foreground="{DynamicResource UiBrush8D9AAD}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
    </StackPanel>
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock Text="Cancel discards folder changes. Existing images outside these folders stay in your scene."
        Foreground="{DynamicResource UiBrush73879C}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="CancelFoldersButton" Content="Cancel" Click="CloseClicked" IsCancel="True" Margin="0,0,8,0" />
        <Button x:Name="ConfirmFoldersButton" Click="ConfirmClicked" IsDefault="True" IsEnabled="False" Background="{DynamicResource UiBrush8BE2C3}">
          <TextBlock Text="Load folders" Foreground="{DynamicResource UiBrush0A2925}" />
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
