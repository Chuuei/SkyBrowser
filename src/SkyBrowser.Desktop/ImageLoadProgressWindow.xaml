<Window
  x:Class="SkyBrowser.Desktop.ImageLoadProgressWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:services="clr-namespace:SkyBrowser.Desktop.Services"
  Title="SkyBrowser · Loading images"
  Width="540"
  SizeToContent="Height"
  ResizeMode="NoResize"
  Style="{StaticResource {x:Type Window}}"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False"
  ShowActivated="False"
  Closing="WindowClosing"
  PreviewKeyDown="WindowPreviewKeyDown">
  <StackPanel Margin="24">
    <TextBlock
      x:Name="Heading"
      Text="Loading images"
      FontSize="23"
      FontWeight="SemiBold" />
    <TextBlock
      x:Name="CountText"
      Text="Finding image files…"
      Foreground="{DynamicResource UiBrush8BE2C3}"
      FontSize="14"
      Margin="0,12,0,9" />
    <ProgressBar
      x:Name="OverallProgress"
      Height="8"
      Minimum="0"
      Maximum="1"
      IsIndeterminate="True"
      Foreground="{DynamicResource UiBrush8BE2C3}"
      Background="{DynamicResource UiBrush1C293A}"
      AutomationProperties.Name="Overall loading progress" />
    <TextBlock
      x:Name="ResultsText" services:Accessibility.LiveSetting="Polite"
      Foreground="{DynamicResource UiBrush8D9AAD}"
      FontSize="11"
      Margin="0,9,0,20"
      TextWrapping="Wrap" />
    <Border
      Background="{DynamicResource UiBrush101B29}"
      BorderBrush="{DynamicResource UiBrush29394D}"
      BorderThickness="1"
      CornerRadius="5"
      Padding="14">
      <StackPanel>
        <TextBlock
          x:Name="CurrentItemText"
          Text="Preparing to load"
          Foreground="{DynamicResource UiBrush8D9AAD}"
          FontSize="10" />
        <TextBlock
          x:Name="FileNameText"
          FontSize="14"
          FontWeight="SemiBold"
          TextTrimming="CharacterEllipsis"
          Margin="0,6,0,14" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock
            x:Name="StageText"
            Text="Finding image files…"
            TextWrapping="Wrap"
            Foreground="{DynamicResource UiBrushB6C4D5}"
            FontSize="12" />
          <TextBlock
            x:Name="StagePercent"
            Grid.Column="1"
            Foreground="{DynamicResource UiBrush8BE2C3}"
            FontSize="12"
            Margin="10,0,0,0" />
        </Grid>
        <ProgressBar
          x:Name="StageProgress"
          Height="4"
          Minimum="0"
          Maximum="100"
          IsIndeterminate="True"
          Margin="0,10,0,0"
          Foreground="{DynamicResource UiBrush8BE2C3}"
          Background="{DynamicResource UiBrush1C293A}"
          AutomationProperties.Name="Current processing step progress" />
      </StackPanel>
    </Border>
    <TextBlock
      x:Name="CancellationNote"
      Foreground="{DynamicResource UiBrush8D9AAD}"
      FontSize="11"
      TextWrapping="Wrap"
      Margin="0,16,0,16"
      LineHeight="17" />
    <Button
      x:Name="CancelLoadButton"
      Content="Cancel loading"
      Click="CancelClicked"
      HorizontalAlignment="Right"
      MinWidth="125" />
  </StackPanel>
</Window>
