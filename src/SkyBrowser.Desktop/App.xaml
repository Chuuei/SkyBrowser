<Application
  x:Class="SkyBrowser.Desktop.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:services="clr-namespace:SkyBrowser.Desktop.Services">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SkyBrowser;component/Styles/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="Window">
        <Setter Property="services:WindowAppearance.UseDarkTitleBar" Value="True" />
        <Setter Property="Icon" Value="pack://application:,,,/SkyBrowser;component/Assets/SkyBrowser.ico" />
        <Setter Property="Background" Value="#080E17" />
        <Setter Property="Foreground" Value="#EDF2F8" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
