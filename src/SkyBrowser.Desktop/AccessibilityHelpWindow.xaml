<Window x:Class="SkyBrowser.Desktop.AccessibilityHelpWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="SkyBrowser · Accessibility help" Width="720" Height="620" MinWidth="480" MinHeight="350"
  Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="24">
    <Button DockPanel.Dock="Bottom" Content="Close" IsCancel="True" IsDefault="True"
      HorizontalAlignment="Right" Margin="0,16,0,0" Click="CloseClicked" />
    <TextBox x:Name="HelpText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
      VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Keyboard and accessibility guide" />
  </DockPanel>
</Window>
