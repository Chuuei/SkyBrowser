<Window
  x:Class="SkyBrowser.Desktop.WelcomeWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:services="clr-namespace:SkyBrowser.Desktop.Services"
  Title="Welcome to SkyBrowser"
  Width="660"
  SizeToContent="Height"
  ResizeMode="NoResize"
  Style="{StaticResource {x:Type Window}}"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False">
  <StackPanel Margin="24">
    <TextBlock Text="Welcome to SkyBrowser" FontSize="25" FontWeight="SemiBold" />
    <TextBlock
      Text="Choose how your images look and, if you like, where you're observing."
      Foreground="{DynamicResource UiBrushA9BDCE}"
      TextWrapping="Wrap"
      Margin="0,8,0,22"
      LineHeight="20" />
    <Border
      Background="{DynamicResource UiBrush101B29}"
      BorderBrush="{DynamicResource UiBrush29394D}"
      BorderThickness="1"
      CornerRadius="6"
      Padding="16">
      <StackPanel>
        <TextBlock Text="Default image stretch" FontSize="15" FontWeight="SemiBold" />
        <ComboBox
          x:Name="StretchChoice"
          SelectionChanged="StretchChanged"
          Margin="0,12,0,0"
          AutomationProperties.Name="Default image stretch">
          <ComboBoxItem Content="Automatic · dark sky (fast, recommended)" />
          <ComboBoxItem Content="Linear / already stretched" />
          <ComboBoxItem Content="Library auto stretch (25%)" />
          <ComboBoxItem Content="Stored display function" />
          <ComboBoxItem Content="Dark sky + cleanup" />
        </ComboBox>
        <TextBlock
          x:Name="StretchDescription"
          Foreground="{DynamicResource UiBrush8D9AAD}"
          FontSize="12"
          TextWrapping="Wrap"
          Margin="0,10,0,0"
          LineHeight="19"
          MinHeight="38" />
      </StackPanel>
    </Border>
    <Border
      Background="{DynamicResource UiBrush101B29}"
      BorderBrush="{DynamicResource UiBrush29394D}"
      BorderThickness="1"
      CornerRadius="6"
      Padding="16"
      Margin="0,16,0,0">
      <StackPanel>
        <TextBlock Text="Your observing location (optional)" FontSize="15" FontWeight="SemiBold" />
        <TextBlock
          x:Name="LocationSummary" services:Accessibility.LiveSetting="Polite"
          Foreground="{DynamicResource UiBrush8BE2C3}"
          TextWrapping="Wrap"
          Margin="0,10,0,14"
          LineHeight="20" />
        <StackPanel Orientation="Horizontal">
          <Button x:Name="ChooseLocationButton" Content="Choose on map…" Click="ChooseLocationClicked" />
          <Button
            x:Name="ClearLocationButton"
            Content="Clear location"
            Click="ClearLocationClicked"
            Margin="8,0,0,0" />
        </StackPanel>
        <TextBlock
          Text="Use your current system time and face south, or explore the atlas without a location."
          Foreground="{DynamicResource UiBrush8D9AAD}"
          FontSize="12"
          TextWrapping="Wrap"
          Margin="0,14,0,0"
          LineHeight="19" />
      </StackPanel>
    </Border>
    <TextBlock
      Text="You can change these choices and all other settings later in Options."
      Foreground="{DynamicResource UiBrush8D9AAD}"
      FontSize="11"
      TextWrapping="Wrap"
      Margin="0,18,0,0" />
    <TextBlock
      x:Name="ValidationMessage" services:Accessibility.LiveSetting="Polite"
      Foreground="{DynamicResource UiBrushE9BA7B}"
      FontSize="11"
      TextWrapping="Wrap"
      Margin="0,10,0,12" />
    <ProgressBar
      x:Name="SaveProgress"
      Height="4"
      IsIndeterminate="True"
      Visibility="Collapsed"
      Margin="0,0,0,12" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button
        x:Name="NotNowButton"
        Content="Not now"
        IsCancel="True"
        Click="NotNowClicked"
        HorizontalAlignment="Left"
        ToolTip="Continue for now; setup will appear again next time if no settings are saved" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button
          x:Name="DefaultsButton"
          Content="Use defaults"
          Click="UseDefaultsClicked"
          Margin="0,0,8,0"
          ToolTip="Save the recommended defaults without an observing location" />
        <Button
          x:Name="StartButton"
          Click="StartClicked"
          IsDefault="True"
          Background="{DynamicResource UiBrush8BE2C3}"
          BorderBrush="{DynamicResource UiBrush8BE2C3}"
          FontWeight="SemiBold">
          <TextBlock Text="Save &amp; start" Foreground="{DynamicResource UiBrush0A2925}" />
        </Button>
      </StackPanel>
    </Grid>
  </StackPanel>
</Window>
