<Window
  x:Class="SkyBrowser.Desktop.OptionsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="SkyBrowser · Options"
  Width="760"
  Height="650"
  MinWidth="680"
  MinHeight="600"
  Style="{StaticResource {x:Type Window}}"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="Options" FontSize="24" FontWeight="SemiBold" />
      <TextBlock
        Text="Your defaults for new images and application starts."
        Foreground="#8D9AAD"
        Margin="0,6,0,0" />
    </StackPanel>
    <TabControl
      x:Name="SettingsTabs"
      Grid.Row="1"
      Background="#101722"
      BorderBrush="#293548"
      Padding="18">
      <TabControl.Resources>
        <Style TargetType="TabItem">
          <Setter Property="Foreground" Value="#A9BDCE" />
          <Setter Property="Padding" Value="18,10" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="TabItem">
                <Border
                  x:Name="TabChrome"
                  Background="#142030"
                  BorderBrush="#293548"
                  BorderThickness="1,1,1,0"
                  Padding="{TemplateBinding Padding}">
                  <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="TabChrome" Property="Background" Value="#24443F" />
                  </Trigger>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="TabChrome" Property="BorderBrush" Value="#8BE2C3" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </TabControl.Resources>
      <TabItem Header="Images">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="ImageSettings" Margin="0,0,10,0">
            <TextBlock Text="Default stretch variant" FontSize="15" FontWeight="SemiBold" />
            <ComboBox x:Name="StretchChoice" SelectionChanged="SelectionChanged" Margin="0,10,0,8">
              <ComboBoxItem Content="Automatic · dark sky (fast)" />
              <ComboBoxItem Content="Linear / already stretched" />
              <ComboBoxItem Content="Library auto stretch (25%)" />
              <ComboBoxItem Content="Stored display function" />
              <ComboBoxItem Content="Dark sky + cleanup" />
            </ComboBox>
            <TextBlock
              Text="Used for images without a saved rendering choice. Per-image choices and sessions keep their own settings."
              Foreground="#8D9AAD"
              FontSize="11"
              TextWrapping="Wrap"
              Margin="0,0,0,22" />
            <TextBlock Text="Default dark-sky finishing" FontSize="15" FontWeight="SemiBold" />
            <TextBlock
              Text="Automatic uses only the background target. The cleanup options below apply to Dark sky + cleanup."
              Foreground="#8D9AAD"
              FontSize="11"
              TextWrapping="Wrap"
              Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,16">
              <TextBlock Text="Sky background" Foreground="#B6C4D5" VerticalAlignment="Center" />
              <TextBox
                x:Name="BackgroundInput"
                Width="75"
                Margin="16,0,7,0"
                TextChanged="InputsChanged" />
              <TextBlock Text="%  (2–25)" Foreground="#8D9AAD" VerticalAlignment="Center" />
            </StackPanel>
            <CheckBox x:Name="BalanceBackground" Content="Balance sky color" Margin="0,0,0,12" />
            <CheckBox x:Name="ReduceGradients" Content="Reduce broad sky gradients" Margin="0,0,0,12" />
            <CheckBox x:Name="ReduceNoise" Content="Smooth background noise" Margin="0,0,0,12" />
            <CheckBox x:Name="EnhanceDetail" Content="Gentle detail and color enhancement" Margin="0,0,0,12" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Observer">
        <StackPanel x:Name="ObserverSettingsPanel">
          <TextBlock
            Text="Startup location and time"
            FontSize="15"
            FontWeight="SemiBold"
            Margin="0,0,0,16" />
          <CheckBox
            x:Name="EnableObserver"
            Content="Use an observer location on startup"
            Checked="ObserverEnabledChanged"
            Unchecked="ObserverEnabledChanged" />
          <TextBlock
            x:Name="ObserverSummary"
            Foreground="#8BE2C3"
            TextWrapping="Wrap"
            Margin="0,16,0,18"
            LineHeight="21" />
          <StackPanel Orientation="Horizontal">
            <Button Content="Choose on map…" Click="ChooseObserverClicked" />
            <Button Content="Clear location" Click="ClearObserverClicked" Margin="8,0,0,0" />
          </StackPanel>
          <TextBlock
            Text="The map opens in a separate window. System time is the default; a chosen fixed time can also be saved. With no observer location, the original atlas view is used."
            Foreground="#8D9AAD"
            FontSize="12"
            TextWrapping="Wrap"
            Margin="0,22,0,0"
            LineHeight="20" />
        </StackPanel>
      </TabItem>
      <TabItem Header="Cache">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="CacheSettings" Margin="0,0,10,0">
            <TextBlock Text="Cache folder" FontSize="15" FontWeight="SemiBold" />
            <Grid Margin="0,10,0,18">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="CacheDirectoryInput" TextChanged="InputsChanged" VerticalContentAlignment="Center" />
              <Button
                Grid.Column="1"
                Content="Browse…"
                Click="BrowseCacheClicked"
                Margin="8,0,0,0" />
            </Grid>
            <TextBlock Text="Maximum stored previews" FontSize="15" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
              <TextBox x:Name="CacheSizeInput" Width="110" TextChanged="InputsChanged" />
              <TextBlock
                Text="GB"
                Foreground="#B6C4D5"
                VerticalAlignment="Center"
                Margin="9,0,0,0" />
              <TextBlock
                x:Name="CacheUsageText"
                Text="Used: loading…"
                Foreground="#8BE2C3"
                FontSize="12"
                VerticalAlignment="Center"
                Margin="24,0,0,0" />
            </StackPanel>
            <TextBlock
              Text="Default: 10 GB. Space is used as previews are added, with older previews removed at the limit. SQLite pages and journals add some disk overhead."
              Foreground="#8D9AAD"
              FontSize="11"
              TextWrapping="Wrap"
              Margin="0,0,0,18"
              LineHeight="18" />
            <TextBlock
              Text="Changing the folder copies saved previews, rendering choices and recent folders into the new cache. Existing entries in the destination are retained. The old cache files are kept in their original folder."
              Foreground="#B6C4D5"
              FontSize="12"
              TextWrapping="Wrap"
              Margin="0,0,0,22"
              LineHeight="19" />
            <Button
              x:Name="ClearPreviewsButton"
              Content="Clear saved previews"
              Click="ClearPreviewsClicked"
              HorizontalAlignment="Left"
              IsEnabled="False"
              Margin="0,0,0,8" />
            <TextBlock
              Text="Clears previews from the active cache immediately, keeping image preferences and recent folders. Loaded images stay visible; future imports may need processing again."
              Foreground="#8D9AAD"
              FontSize="11"
              TextWrapping="Wrap"
              Margin="0,0,0,22"
              LineHeight="18" />
            <TextBlock
              Text="Options file"
              Foreground="#8D9AAD"
              FontSize="11"
              Margin="0,0,0,6" />
            <TextBox x:Name="OptionsFilePath" IsReadOnly="True" FontSize="11" />
            <TextBlock
              Text="Options stay here when the cache folder changes."
              Foreground="#73879C"
              FontSize="11"
              Margin="0,7,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Sky">
        <StackPanel x:Name="SkySettings">
          <TextBlock
            Text="Startup sky display"
            FontSize="15"
            FontWeight="SemiBold"
            Margin="0,0,0,18" />
          <CheckBox x:Name="ShowGrid" Content="Coordinate grid" Margin="0,0,0,14" />
          <CheckBox x:Name="ShowConstellations" Content="Constellation lines" Margin="0,0,0,14" />
          <CheckBox x:Name="ShowLabels" Content="Sky labels" Margin="0,0,0,14" />
          <CheckBox x:Name="ShowOutlines" Content="Image outlines" Margin="0,0,0,14" />
          <CheckBox
            x:Name="BlendOverlaps"
            Content="Blend overlapping images and reveal insets on hover"
            Margin="0,0,0,14" />
          <TextBlock
            Text="These defaults also apply when you save options. Sessions retain their explicitly saved display settings."
            Foreground="#8D9AAD"
            FontSize="12"
            TextWrapping="Wrap"
            Margin="0,12,0,0" />
        </StackPanel>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Margin="0,16,0,0">
      <ProgressBar
        x:Name="SaveProgress"
        Height="4"
        IsIndeterminate="True"
        Visibility="Collapsed"
        Margin="0,0,0,10" />
      <TextBlock
        x:Name="ValidationMessage"
        Foreground="#E9BA7B"
        FontSize="11"
        TextWrapping="Wrap"
        Margin="0,0,0,12" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button
          x:Name="DefaultsButton"
          Content="Restore defaults"
          Click="RestoreDefaultsClicked"
          HorizontalAlignment="Left" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button
            x:Name="CancelButton"
            Content="Cancel"
            IsCancel="True"
            Margin="0,0,8,0" />
          <Button
            x:Name="SaveButton"
            IsDefault="True"
            Click="SaveClicked"
            Background="#8BE2C3"
            BorderBrush="#8BE2C3">
            <TextBlock Text="Save options" Foreground="#0A2925" />
          </Button>
        </StackPanel>
      </Grid>
    </StackPanel>
  </Grid>
</Window>
