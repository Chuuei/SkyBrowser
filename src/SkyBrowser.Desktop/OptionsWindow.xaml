<Window
  x:Class="SkyBrowser.Desktop.OptionsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:services="clr-namespace:SkyBrowser.Desktop.Services"
  Title="SkyBrowser · Options"
  Width="760"
  Height="650"
  MinWidth="680"
  MinHeight="600"
  Style="{StaticResource {x:Type Window}}"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="Options" FontSize="24" FontWeight="SemiBold" />
      <TextBlock
        Text="Your defaults for new images and application starts."
        Foreground="{DynamicResource UiBrush8D9AAD}"
        Margin="0,6,0,0" />
    </StackPanel>
    <TabControl
      x:Name="SettingsTabs"
      Grid.Row="1"
      Background="{DynamicResource UiBrush101722}"
      BorderBrush="{DynamicResource UiBrush293548}"
      Padding="18">
      <TabControl.Resources>
        <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
          <Setter Property="Padding" Value="18,10" />
        </Style>
      </TabControl.Resources>
      <TabItem Header="Images">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="ImageSettings" Margin="0,0,10,0">
            <TextBlock Text="Default stretch variant" FontSize="15" FontWeight="SemiBold" />
            <ComboBox x:Name="StretchChoice" AutomationProperties.Name="Default image stretch"
              SelectionChanged="SelectionChanged" Margin="0,10,0,8">
              <ComboBoxItem Content="Automatic · dark sky (fast)" />
              <ComboBoxItem Content="Linear / already stretched" />
              <ComboBoxItem Content="Library auto stretch (25%)" />
              <ComboBoxItem Content="Stored display function" />
              <ComboBoxItem Content="Dark sky + cleanup" />
            </ComboBox>
            <TextBlock
              Text="Used for images without a saved rendering choice. Per-image choices keep their own settings."
              Foreground="{DynamicResource UiBrush8D9AAD}"
              FontSize="11"
              TextWrapping="Wrap"
              Margin="0,0,0,22" />
            <TextBlock Text="Default dark-sky finishing" FontSize="15" FontWeight="SemiBold" />
            <TextBlock
              Text="Automatic uses only the background target. The cleanup options below apply to Dark sky + cleanup."
              Foreground="{DynamicResource UiBrush8D9AAD}"
              FontSize="11"
              TextWrapping="Wrap"
              Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,16">
              <TextBlock Text="Sky background" Foreground="{DynamicResource UiBrushB6C4D5}" VerticalAlignment="Center" />
              <TextBox
                x:Name="BackgroundInput"
                AutomationProperties.Name="Sky background (%)"
                Width="75"
                Margin="16,0,7,0"
                TextChanged="InputsChanged" />
              <TextBlock Text="%  (2–25)" Foreground="{DynamicResource UiBrush8D9AAD}" VerticalAlignment="Center" />
            </StackPanel>
            <CheckBox x:Name="BalanceBackground" Content="Balance sky color" Margin="0,0,0,12" />
            <CheckBox x:Name="ReduceGradients" Content="Reduce broad sky gradients" Margin="0,0,0,12" />
            <CheckBox x:Name="ReduceNoise" Content="Smooth background noise" Margin="0,0,0,12" />
            <CheckBox x:Name="EnhanceDetail" Content="Gentle detail and color enhancement" Margin="0,0,0,12" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Observer">
        <StackPanel x:Name="ObserverSettingsPanel">
          <TextBlock
            Text="Startup location and time"
            FontSize="15"
            FontWeight="SemiBold"
            Margin="0,0,0,16" />
          <CheckBox
            x:Name="EnableObserver"
            Content="Use an observer location on startup"
            Checked="ObserverEnabledChanged"
            Unchecked="ObserverEnabledChanged" />
          <TextBlock
            x:Name="ObserverSummary" services:Accessibility.LiveSetting="Polite"
            Foreground="{DynamicResource UiBrush8BE2C3}"
            TextWrapping="Wrap"
            Margin="0,16,0,18"
            LineHeight="21" />
          <StackPanel Orientation="Horizontal">
            <Button Content="Choose on map…" Click="ChooseObserverClicked" />
            <Button Content="Clear location" Click="ClearObserverClicked" Margin="8,0,0,0" />
          </StackPanel>
          <TextBlock
            Text="The map opens in a separate window. System time is the default; a chosen fixed time can also be saved. With no observer location, the original atlas view is used."
            Foreground="{DynamicResource UiBrush8D9AAD}"
            FontSize="12"
            TextWrapping="Wrap"
            Margin="0,22,0,0"
            LineHeight="20" />
        </StackPanel>
      </TabItem>
      <TabItem Header="Cache">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="CacheSettings" Margin="0,0,10,0">
            <TextBlock Text="Cache folder" FontSize="15" FontWeight="SemiBold" />
            <Grid Margin="0,10,0,18">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="CacheDirectoryInput" AutomationProperties.Name="Preview cache folder"
                TextChanged="InputsChanged" VerticalContentAlignment="Center" />
              <Button
                Grid.Column="1"
                Content="Browse…"
                AutomationProperties.Name="Browse for preview cache folder"
                Click="BrowseCacheClicked"
                Margin="8,0,0,0" />
            </Grid>
            <TextBlock Text="Maximum stored previews" FontSize="15" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
              <TextBox x:Name="CacheSizeInput" AutomationProperties.Name="Preview cache limit (GB)"
                Width="110" TextChanged="InputsChanged" />
              <TextBlock
                Text="GB"
                Foreground="{DynamicResource UiBrushB6C4D5}"
                VerticalAlignment="Center"
                Margin="9,0,0,0" />
              <TextBlock
                x:Name="CacheUsageText"
                Text="Used: loading…"
                Foreground="{DynamicResource UiBrush8BE2C3}"
                FontSize="12"
                VerticalAlignment="Center"
                Margin="24,0,0,0" />
            </StackPanel>
            <TextBlock
              Text="Default: 10 GB. Space is used as previews are added, with older previews removed at the limit. SQLite pages and journals add some disk overhead."
              Foreground="{DynamicResource UiBrush8D9AAD}"
              FontSize="11"
              TextWrapping="Wrap"
              Margin="0,0,0,18"
              LineHeight="18" />
            <TextBlock
              Text="Changing the folder copies saved previews, rendering choices and recent folders into the new cache. Existing entries in the destination are retained. The old cache files are kept in their original folder."
              Foreground="{DynamicResource UiBrushB6C4D5}"
              FontSize="12"
              TextWrapping="Wrap"
              Margin="0,0,0,22"
              LineHeight="19" />
            <Button
              x:Name="ClearPreviewsButton"
              Content="Clear saved previews"
              Click="ClearPreviewsClicked"
              HorizontalAlignment="Left"
              IsEnabled="False"
              Margin="0,0,0,8" />
            <TextBlock
              Text="Clears previews from the active cache immediately, keeping image preferences and recent folders. Loaded images stay visible; future imports may need processing again."
              Foreground="{DynamicResource UiBrush8D9AAD}"
              FontSize="11"
              TextWrapping="Wrap"
              Margin="0,0,0,22"
              LineHeight="18" />
            <TextBlock
              Text="Options file"
              Foreground="{DynamicResource UiBrush8D9AAD}"
              FontSize="11"
              Margin="0,0,0,6" />
            <TextBox x:Name="OptionsFilePath" AutomationProperties.Name="Settings file"
              IsReadOnly="True" FontSize="11" />
            <TextBlock
              Text="Options stay here when the cache folder changes."
              Foreground="{DynamicResource UiBrush73879C}"
              FontSize="11"
              Margin="0,7,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Plate solving">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="ASTAP blind solving" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="Install ASTAP and a star database, then choose the executable. Solving searches the entire sky and leaves your originals unchanged."
              Foreground="{DynamicResource UiBrush8D9AAD}" TextWrapping="Wrap" Margin="0,10,0,18" />
            <TextBlock Text="ASTAP executable" Margin="0,0,0,6" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Browse…" AutomationProperties.Name="Browse for ASTAP executable"
                Click="BrowseAstapClicked" Margin="8,0,0,0" />
              <TextBox x:Name="AstapPathInput" AutomationProperties.Name="ASTAP executable"
                TextChanged="InputsChanged" />
            </DockPanel>
            <TextBlock Text="Star database folder (optional; blank uses ASTAP's installation)" Margin="0,16,0,6" TextWrapping="Wrap" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Browse…" AutomationProperties.Name="Browse for ASTAP star database"
                Click="BrowseAstapDatabaseClicked" Margin="8,0,0,0" />
              <TextBox x:Name="AstapDatabaseInput" AutomationProperties.Name="ASTAP star database folder"
                TextChanged="InputsChanged" />
            </DockPanel>
            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="24" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Time limit (seconds)" Margin="0,0,0,6" />
                <TextBox x:Name="AstapTimeoutInput" AutomationProperties.Name="ASTAP timeout (seconds)"
                  TextChanged="InputsChanged" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Image height (degrees; 0 = auto)" Margin="0,0,0,6" />
                <TextBox x:Name="AstapFieldInput" AutomationProperties.Name="ASTAP field height (degrees)"
                  TextChanged="InputsChanged" />
              </StackPanel>
            </Grid>
            <TextBlock Text="Set image height for unusual fields; 0 searches ASTAP's automatic range."
              Foreground="{DynamicResource UiBrush8D9AAD}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Sky">
        <StackPanel x:Name="SkySettings">
          <TextBlock
            Text="Startup sky display"
            FontSize="15"
            FontWeight="SemiBold"
            Margin="0,0,0,18" />
          <CheckBox x:Name="ShowGrid" Content="Coordinate grid" Margin="0,0,0,14" />
          <CheckBox x:Name="ShowConstellations" Content="Constellation lines" Margin="0,0,0,14" />
          <CheckBox x:Name="ShowLabels" Content="Sky labels" Margin="0,0,0,14" />
          <CheckBox x:Name="ShowMoon" Content="Moon position and phase" Margin="0,0,0,14" ToolTip="Show an illustrative Moon at its calculated sky position. Uses scene time and observer location, or live UTC in atlas mode." />
          <CheckBox x:Name="ShowOutlines" Content="Image outlines" Margin="0,0,0,14" />
          <CheckBox
            x:Name="BlendOverlaps"
            Content="Blend overlapping images and reveal insets on hover"
            Margin="0,0,0,14" />
          <CheckBox x:Name="ShowCachedSurveyImages" Content="Show cached DSS2 images by default" Margin="0,0,0,8" />
          <TextBlock Text="Restore saved survey regions behind your images. Uses only the local survey cache; nothing is downloaded."
            Foreground="{DynamicResource UiBrush8D9AAD}" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,8" />
          <TextBlock
            Text="These defaults also apply when you save options and when the application starts."
            Foreground="{DynamicResource UiBrush8D9AAD}"
            FontSize="12"
            TextWrapping="Wrap"
            Margin="0,12,0,0" />
        </StackPanel>
      </TabItem>
      <TabItem Header="Accessibility">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,10,0">
            <TextBlock Text="Reading and interaction" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Interface size" Margin="0,18,0,8" />
            <ComboBox x:Name="InterfaceScaleChoice" AutomationProperties.Name="Interface size"
              SelectionChanged="SelectionChanged" ToolTip="Enlarge all text and controls; Tab scrolls focused controls into view.">
              <ComboBoxItem Content="100%" Tag="1" /><ComboBoxItem Content="125%" Tag="1.25" />
              <ComboBoxItem Content="150%" Tag="1.5" /><ComboBoxItem Content="175%" Tag="1.75" />
              <ComboBoxItem Content="200%" Tag="2" />
            </ComboBox>
            <CheckBox x:Name="HighContrastChoice" Content="Use high contrast colors" Margin="0,20,0,14" />
            <TextBlock Text="Uses Windows window and text colors. Windows contrast themes are always respected."
              TextWrapping="Wrap" Margin="0,0,0,18" />
            <CheckBox x:Name="ReduceMotionChoice" Content="Reduce motion and disable automatic blinking" Margin="0,0,0,14" />
            <TextBlock Text="Keeps comparisons still; Switch frame changes images manually. Windows animation preferences are also respected."
              TextWrapping="Wrap" Margin="0,0,0,18" />
            <TextBlock Text="Press F1 in any window for the keyboard and accessibility guide. F6 moves between the main collection, target search and sky view."
              TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Margin="0,16,0,0">
      <ProgressBar
        x:Name="SaveProgress"
        Height="4"
        IsIndeterminate="True"
        Visibility="Collapsed"
        Margin="0,0,0,10" />
      <TextBlock
        x:Name="ValidationMessage" services:Accessibility.LiveSetting="Polite"
        Foreground="{DynamicResource UiBrushE9BA7B}"
        FontSize="11"
        TextWrapping="Wrap"
        Margin="0,0,0,12" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button
          x:Name="DefaultsButton"
          Content="Restore defaults"
          Click="RestoreDefaultsClicked"
          HorizontalAlignment="Left" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button
            x:Name="CancelButton"
            Content="Cancel"
            IsCancel="True"
            Margin="0,0,8,0" />
          <Button
            x:Name="SaveButton"
            IsDefault="True"
            Click="SaveClicked"
            Background="{DynamicResource UiBrush8BE2C3}"
            BorderBrush="{DynamicResource UiBrush8BE2C3}">
            <TextBlock Text="Save options" Foreground="{DynamicResource UiBrush0A2925}" />
          </Button>
        </StackPanel>
      </Grid>
    </StackPanel>
  </Grid>
</Window>
