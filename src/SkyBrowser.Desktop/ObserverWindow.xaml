<Window
  x:Class="SkyBrowser.Desktop.ObserverWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:SkyBrowser.Desktop.Controls"
  Title="SkyBrowser · Location &amp; time"
  Width="1000"
  Height="710"
  MinWidth="820"
  MinHeight="650"
  Style="{StaticResource {x:Type Window}}"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20">
      <TextBlock Text="Where are you observing?" FontSize="24" FontWeight="SemiBold" />
      <TextBlock
        Text="Choose a point on the map and a time. Your sky will face south, with the local horizon level."
        Foreground="#8D9AAD"
        Margin="0,7,0,0"
        TextWrapping="Wrap" />
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="22" />
        <ColumnDefinition Width="270" />
      </Grid.ColumnDefinitions>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border
          BorderBrush="#344C5E"
          BorderThickness="1"
          CornerRadius="5"
          ClipToBounds="True">
          <Grid>
            <local:ObserverMap
              x:Name="Map"
              LocationSelected="MapLocationSelected"
              AutomationProperties.Name="Choose observer location on the world map" />
            <StackPanel
              Orientation="Horizontal"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="10">
              <Button
                Content="+"
                Click="ZoomInClicked"
                Padding="11,5"
                ToolTip="Zoom in" />
              <Button
                Content="−"
                Click="ZoomOutClicked"
                Padding="11,5"
                Margin="5,0"
                ToolTip="Zoom out" />
              <Button Content="World" Click="WorldClicked" Padding="9,5" />
            </StackPanel>
            <Border
              Background="#D9101722"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Left"
              Margin="10"
              Padding="8,5"
              CornerRadius="3"
              IsHitTestVisible="False">
              <TextBlock Text="Offline map · Natural Earth" Foreground="#8D9AAD" FontSize="10" />
            </Border>
          </Grid>
        </Border>
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
          <TextBlock
            Text="Click to place your marker · Drag to pan · Scroll to zoom"
            Foreground="#B4C5D4"
            FontSize="11" />
          <TextBlock
            Text="For an exact position, enter latitude and longitude. The map works without an internet connection."
            Foreground="#73879C"
            FontSize="11"
            TextWrapping="Wrap"
            Margin="0,6,0,0" />
        </StackPanel>
      </Grid>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,0">
          <TextBlock
            Text="OBSERVER LOCATION"
            FontSize="10"
            Foreground="#8D9AAD"
            Margin="0,0,0,12" />
          <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="10" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Latitude (° north)" FontSize="12" Foreground="#B4C5D4" />
              <TextBox
                x:Name="LatitudeInput"
                AutomationProperties.Name="Observer latitude"
                TextChanged="InputsChanged"
                Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Longitude (° east)" FontSize="12" Foreground="#B4C5D4" />
              <TextBox
                x:Name="LongitudeInput"
                AutomationProperties.Name="Observer longitude"
                TextChanged="InputsChanged"
                Margin="0,5,0,0" />
            </StackPanel>
          </Grid>
          <TextBlock Text="Use negative values for south or west." FontSize="10" Foreground="#73879C" />
          <Button
            Content="Center map on marker"
            Click="CenterMarkerClicked"
            HorizontalAlignment="Left"
            Padding="10,6"
            Margin="0,12,0,16" />
          <Border BorderBrush="#293548" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <StackPanel>
              <TextBlock
                Text="OBSERVING TIME"
                FontSize="10"
                Foreground="#8D9AAD"
                Margin="0,0,0,12" />
              <CheckBox
                x:Name="UseSystemTime"
                Content="Use current system time"
                IsChecked="True"
                Checked="TimeModeChanged"
                Unchecked="TimeModeChanged" />
              <TextBlock
                x:Name="SystemTimeReadout"
                FontSize="11"
                Foreground="#8BE2C3"
                TextWrapping="Wrap"
                Margin="0,8,0,14" />
              <StackPanel x:Name="CustomTimePanel" IsEnabled="False" Visibility="Collapsed">
                <TextBlock Text="Date" FontSize="12" Foreground="#B4C5D4" />
                <DatePicker
                  x:Name="DateInput"
                  SelectedDateChanged="DateChanged"
                  Margin="0,5,0,12"
                  DisplayDateStart="1900-01-01"
                  DisplayDateEnd="2100-12-31"
                  Background="#0B121D"
                  Foreground="#E3ECF7">
                  <DatePicker.Resources>
                    <Style TargetType="DatePickerTextBox">
                      <Setter Property="Foreground" Value="#E3ECF7" />
                      <Setter Property="Background" Value="#0B121D" />
                      <Setter Property="Padding" Value="6" />
                    </Style>
                  </DatePicker.Resources>
                  <DatePicker.CalendarStyle>
                    <Style TargetType="Calendar">
                      <Setter Property="Foreground" Value="#142131" />
                      <Setter Property="Background" Value="#EDF2F8" />
                    </Style>
                  </DatePicker.CalendarStyle>
                </DatePicker>
                <TextBlock Text="Time (24-hour, HH:mm:ss)" FontSize="12" Foreground="#B4C5D4" />
                <TextBox x:Name="TimeInput" TextChanged="InputsChanged" Margin="0,5,0,12" />
                <TextBlock Text="Time zone" FontSize="12" Foreground="#B4C5D4" />
                <ComboBox
                  x:Name="TimeZoneInput"
                  SelectedIndex="0"
                  SelectionChanged="ZoneChanged"
                  Margin="0,5,0,6">
                  <ComboBoxItem Content="Computer local time" />
                  <ComboBoxItem Content="UTC" />
                </ComboBox>
                <TextBlock
                  x:Name="TimeZoneDescription"
                  FontSize="10"
                  Foreground="#73879C"
                  TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <StackPanel Grid.Row="2" Margin="0,18,0,0">
      <TextBlock
        x:Name="ValidationMessage"
        Foreground="#E9BA7B"
        FontSize="11"
        TextWrapping="Wrap"
        Margin="0,0,0,12" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button
          Content="Use atlas view"
          Click="ClearClicked"
          HorizontalAlignment="Left"
          ToolTip="Remove the observer location and restore the original sky view" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
          <Button
            x:Name="ApplyButton"
            IsDefault="True"
            Click="ApplyClicked"
            Background="#8BE2C3"
            Foreground="#0A2925"
            BorderBrush="#8BE2C3">
            <TextBlock Text="Apply &amp; face south" Foreground="#0A2925" />
          </Button>
        </StackPanel>
      </Grid>
    </StackPanel>
  </Grid>
</Window>
