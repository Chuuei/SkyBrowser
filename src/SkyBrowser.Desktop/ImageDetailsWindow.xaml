<Window
  x:Class="SkyBrowser.Desktop.ImageDetailsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="SkyBrowser · Image details"
  Width="900"
  Height="800"
  MinWidth="700"
  MinHeight="640"
  Style="{StaticResource {x:Type Window}}"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False">
  <Window.Resources>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource UiBrush1C293A}" />
      <Setter Property="Foreground" Value="{DynamicResource UiBrushB6C4D5}" />
      <Setter Property="Padding" Value="8,9" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource UiBrush344256}" />
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Foreground" Value="{DynamicResource UiBrushDFE8F2}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="7,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource UiBrush24443F}" />
          <Setter Property="Foreground" Value="{DynamicResource UiBrushEDF2F8}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="{DynamicResource UiBrush101722}" />
      <Setter Property="Foreground" Value="{DynamicResource UiBrushDFE8F2}" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource UiBrush24443F}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="MetadataText" TargetType="TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock
        Text="Image details"
        FontSize="11"
        Foreground="{DynamicResource UiBrush8D9AAD}"
        Margin="0,0,0,5" />
      <TextBlock
        x:Name="ImageName"
        FontSize="23"
        FontWeight="SemiBold"
        TextTrimming="CharacterEllipsis" />
      <TextBox
        x:Name="FilePathText" AutomationProperties.Name="Original image file path"
        IsReadOnly="True"
        FontSize="11"
        Margin="0,10,0,0" />
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="158" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Border
        Background="{DynamicResource UiBrush0B121D}"
        BorderBrush="{DynamicResource UiBrush293548}"
        BorderThickness="1"
        Height="170"
        VerticalAlignment="Top"
        Padding="6">
        <Image x:Name="ImagePreview" Stretch="Uniform" />
      </Border>
      <StackPanel Grid.Column="2">
        <TextBox
          x:Name="ImageFacts" AutomationProperties.Name="Image dimensions and scientific format"
          IsReadOnly="True"
          TextWrapping="Wrap"
          Background="Transparent"
          BorderThickness="0"
          Padding="0"
          FontSize="12"
          MaxHeight="145"
          VerticalScrollBarVisibility="Auto" />
        <TextBox
          x:Name="FileFacts" AutomationProperties.Name="Original file details"
          Text="Reading file information…"
          IsReadOnly="True"
          TextWrapping="Wrap"
          Background="Transparent"
          BorderThickness="0"
          Padding="0"
          FontSize="11"
          Foreground="{DynamicResource UiBrush8D9AAD}"
          Margin="0,10,0,0"
          MaxHeight="60"
          VerticalScrollBarVisibility="Auto" />
      </StackPanel>
    </Grid>
    <Grid Grid.Row="2" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="260" />
      </Grid.ColumnDefinitions>
      <TextBlock
        Text="Image metadata"
        FontSize="15"
        FontWeight="SemiBold"
        VerticalAlignment="Center" />
      <DockPanel Grid.Column="1">
        <TextBlock
          Text="Search"
          Foreground="{DynamicResource UiBrush8D9AAD}"
          VerticalAlignment="Center"
          Margin="0,0,9,0"
          FontSize="12" />
        <TextBox
          x:Name="MetadataSearch"
          TextChanged="MetadataSearchChanged"
          ToolTip="Filter keywords, values, comments and sources"
          AutomationProperties.Name="Search image metadata" />
      </DockPanel>
    </Grid>
    <DataGrid
      x:Name="MetadataGrid" AutomationProperties.Name="Image metadata"
      Grid.Row="3"
      AutoGenerateColumns="False"
      IsReadOnly="True"
      CanUserAddRows="False"
      CanUserDeleteRows="False"
      CanUserReorderColumns="False"
      HeadersVisibility="Column"
      RowHeaderWidth="0"
      GridLinesVisibility="Horizontal"
      HorizontalGridLinesBrush="{DynamicResource UiBrush233044}"
      Background="{DynamicResource UiBrush101722}"
      BorderBrush="{DynamicResource UiBrush293548}"
      Foreground="{DynamicResource UiBrushDFE8F2}"
      SelectionMode="Single"
      SelectionUnit="FullRow"
      EnableRowVirtualization="True"
      VirtualizingPanel.VirtualizationMode="Recycling"
      ClipboardCopyMode="IncludeHeader"
      SelectionChanged="MetadataSelectionChanged"
      FontSize="11"
      MinHeight="100">
      <DataGrid.Columns>
        <DataGridTextColumn
          Header="Source"
          Binding="{Binding Source}"
          Width="65"
          ElementStyle="{StaticResource MetadataText}" />
        <DataGridTextColumn
          Header="Keyword / property"
          Binding="{Binding Name}"
          Width="1.1*"
          ElementStyle="{StaticResource MetadataText}" />
        <DataGridTextColumn
          Header="Value"
          Binding="{Binding Value}"
          Width="1.3*"
          ElementStyle="{StaticResource MetadataText}" />
        <DataGridTextColumn
          Header="Comment"
          Binding="{Binding Comment}"
          Width="*"
          ElementStyle="{StaticResource MetadataText}" />
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="4" Margin="0,8,0,0">
      <TextBlock
        x:Name="MetadataCount"
        FontSize="11"
        Foreground="{DynamicResource UiBrush8D9AAD}"
        TextWrapping="Wrap" />
      <TextBox
        x:Name="SelectedMetadata" AutomationProperties.Name="Selected metadata value"
        Text="Select a metadata row to read and copy its value."
        IsReadOnly="True"
        TextWrapping="Wrap"
        Height="70"
        VerticalScrollBarVisibility="Auto"
        Margin="0,8,0,0"
        FontSize="12" />
    </StackPanel>
    <Grid Grid.Row="5" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock
        x:Name="FooterText"
        Text="Metadata belongs to the loaded image. Source files stay untouched."
        Foreground="{DynamicResource UiBrush73879C}"
        FontSize="11"
        VerticalAlignment="Center"
        TextWrapping="Wrap"
        Margin="0,0,16,0" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="InspectImageButton" Content="Inspect full resolution…" Click="InspectClicked" Margin="0,0,8,0" />
        <Button
        Content="Close"
        IsCancel="True"
        IsDefault="True"
        Click="CloseClicked"
        MinWidth="80" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
